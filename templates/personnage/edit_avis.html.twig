{% extends 'base.html.twig' %}

{% block title %}Modifier mon avis - {{ personnage.nom }}{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="mb-4">
        <a href="{{ path('app_personnage_show', {id: personnage.id}) }}" class="btn btn-outline-light btn-sm">
            <i class="bi bi-arrow-left me-2"></i>
            Retour au personnage
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card card-fantasy">
                <div class="card-body p-4">
                    <h2 class="mb-4">
                        <i class="bi bi-pencil text-primary me-2"></i>
                        Modifier mon avis
                    </h2>

                    <div class="alert alert-info mb-4">
                        <i class="bi bi-info-circle me-2"></i>
                        Votre avis modifié sera à nouveau examiné par notre équipe avant publication.
                    </div>

                    <div class="mb-4 p-3 bg-dark bg-opacity-25 rounded">
                        <p class="text-muted small mb-1">Personnage concerné</p>
                        <h5 class="mb-0">{{ personnage.nom }}</h5>
                    </div>

                    {{ form_start(form) }}
                        <div class="mb-4">
                            <label class="form-label fw-bold">Note</label>
                            <div class="star-rating mb-2">
                                {% for i in 1..5 %}
                                    <i class="bi bi-star-fill star-icon" data-rating="{{ i }}" style="font-size: 2rem; cursor: pointer; color: {{ i <= commentaire.note ? '#ffc107' : '#6c757d' }};"></i>
                                {% endfor %}
                            </div>
                            <small class="text-muted d-block" id="rating-text">
                                {% if commentaire.note %}
                                    Note actuelle : {{ commentaire.note }} étoile{{ commentaire.note > 1 ? 's' : '' }}
                                {% else %}
                                    Cliquez sur les étoiles pour noter
                                {% endif %}
                            </small>
                            <div style="display: none;">
                                {{ form_widget(form.note) }}
                            </div>
                            {{ form_errors(form.note) }}
                        </div>

                        <div class="mb-4">
                            {{ form_label(form.commentaire, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                            {{ form_widget(form.commentaire) }}
                            <small class="text-muted">Minimum 10 caractères, maximum 1000 caractères</small>
                            {{ form_errors(form.commentaire) }}
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-check-circle me-2"></i>
                                Enregistrer les modifications
                            </button>
                            <a href="{{ path('app_personnage_show', {id: personnage.id}) }}" class="btn btn-secondary btn-lg">
                                Annuler
                            </a>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>

{# Le JavaScript est maintenant géré dans assets/app.js #}
{% endblock %}


