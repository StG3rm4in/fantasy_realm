{% extends 'base.html.twig' %}

{% block title %}Galerie des personnages - FantasyRealm Online{% endblock %}

{% block body %}
<div class="container py-5">
    {# Page Header #}
    <div class="text-center mb-5">
        <h1 class="display-5 fw-bold mb-3">
            <i class="bi bi-people text-primary" aria-hidden="true"></i>
            Galerie des personnages
        </h1>
        <p class="text-secondary mx-auto" style="max-width: 600px;">
            Découvrez les créations de la communauté FantasyRealm Online.
        </p>
    </div>

    {# Filter Form #}
    <div class="card bg-dark border-secondary mb-4">
        <div class="card-body p-3">
            <form method="get" action="{{ path('app_personnages') }}" class="row g-3 align-items-end" role="search" aria-label="Filtrer les personnages">
                <div class="col-sm-6 col-md-3">
                    <label for="filter-genre" class="form-label small">
                        <i class="bi bi-gender-ambiguous text-primary me-1" aria-hidden="true"></i>
                        Genre
                    </label>
                    <select class="form-select form-select-sm" id="filter-genre" name="genre">
                        <option value="">Tous</option>
                        <option value="Masculin" {{ filters.genre|default('') == 'Masculin' ? 'selected' : '' }}>Masculin</option>
                        <option value="Féminin" {{ filters.genre|default('') == 'Féminin' ? 'selected' : '' }}>Féminin</option>
                        <option value="Autre" {{ filters.genre|default('') == 'Autre' ? 'selected' : '' }}>Autre</option>
                    </select>
                </div>

                <div class="col-sm-6 col-md-2">
                    <label for="filter-date-debut" class="form-label small">
                        <i class="bi bi-calendar-event text-primary me-1" aria-hidden="true"></i>
                        Date début
                    </label>
                    <input type="date"
                           class="form-control form-control-sm"
                           id="filter-date-debut"
                           name="date_debut"
                           value="{{ filters.date_debut|default('') }}">
                </div>

                <div class="col-sm-6 col-md-2">
                    <label for="filter-date-fin" class="form-label small">
                        <i class="bi bi-calendar-check text-primary me-1" aria-hidden="true"></i>
                        Date fin
                    </label>
                    <input type="date"
                           class="form-control form-control-sm"
                           id="filter-date-fin"
                           name="date_fin"
                           value="{{ filters.date_fin|default('') }}">
                </div>

                <div class="col-sm-6 col-md-3">
                    <label for="filter-pseudo" class="form-label small">
                        <i class="bi bi-person text-primary me-1" aria-hidden="true"></i>
                        Pseudo du créateur
                    </label>
                    <input type="text"
                           class="form-control form-control-sm"
                           id="filter-pseudo"
                           name="pseudo"
                           value="{{ filters.pseudo|default('') }}"
                           placeholder="Rechercher un pseudo...">
                </div>

                <div class="col-12 col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary btn-sm flex-grow-1">
                        <i class="bi bi-search me-1" aria-hidden="true"></i>
                        Filtrer
                    </button>
                    <a href="{{ path('app_personnages') }}" class="btn btn-outline-secondary btn-sm" aria-label="Réinitialiser les filtres">
                        <i class="bi bi-x-lg" aria-hidden="true"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    {# Characters Grid #}
    {% if personnages|length > 0 %}
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
            {% for personnage in personnages %}
                <div class="col">
                    <a href="{{ path('app_personnage_show', { id: personnage.id }) }}" class="text-decoration-none">
                        <div class="card bg-dark border-secondary h-100 card-hover">
                            {% if personnage.imageDataUrl %}
                                <img src="{{ personnage.imageDataUrl }}"
                                     class="card-img-top"
                                     alt="Portrait de {{ personnage.nom }}"
                                     style="height: 280px; object-fit: cover;">
                            {% else %}
                                <div class="card-img-top d-flex align-items-center justify-content-center bg-secondary" style="height: 280px;">
                                    <i class="bi bi-person-bounding-box display-1 text-muted" aria-hidden="true"></i>
                                </div>
                            {% endif %}
                            <div class="card-body">
                                <h2 class="card-title h6 text-light mb-1">{{ personnage.nom }}</h2>
                                <p class="card-text small text-secondary mb-0">
                                    <i class="bi bi-person-circle me-1" aria-hidden="true"></i>
                                    {{ personnage.utilisateur.pseudo }}
                                </p>
                            </div>
                            <div class="card-footer bg-transparent border-secondary d-flex justify-content-between align-items-center">
                                <span class="badge bg-primary bg-opacity-25">{{ personnage.genre }}</span>
                                <small class="text-secondary">
                                    <i class="bi bi-calendar3 me-1" aria-hidden="true"></i>
                                    {{ personnage.dateCreation|date('d/m/Y') }}
                                </small>
                            </div>
                        </div>
                    </a>
                </div>
            {% endfor %}
        </div>

        {# Pagination #}
        {% if totalPages > 1 %}
            <nav class="mt-5" aria-label="Pagination de la galerie">
                <ul class="pagination justify-content-center flex-wrap gap-1">
                    <li class="page-item {{ currentPage <= 1 ? 'disabled' : '' }}">
                        <a class="page-link" href="{{ path('app_personnages', {
                            page: currentPage - 1,
                            genre: filters.genre,
                            date_debut: filters.date_debut,
                            date_fin: filters.date_fin,
                            pseudo: filters.pseudo
                        }) }}" {% if currentPage <= 1 %}tabindex="-1" aria-disabled="true"{% endif %}>
                            <i class="bi bi-chevron-left" aria-hidden="true"></i>
                            Précédent
                        </a>
                    </li>
                    {% for p in 1..totalPages %}
                        <li class="page-item {{ p == currentPage ? 'active' : '' }}">
                            <a class="page-link" href="{{ path('app_personnages', {
                                page: p,
                                genre: filters.genre,
                                date_debut: filters.date_debut,
                                date_fin: filters.date_fin,
                                pseudo: filters.pseudo
                            }) }}" {% if p == currentPage %}aria-current="page"{% endif %}>{{ p }}</a>
                        </li>
                    {% endfor %}
                    <li class="page-item {{ currentPage >= totalPages ? 'disabled' : '' }}">
                        <a class="page-link" href="{{ path('app_personnages', {
                            page: currentPage + 1,
                            genre: filters.genre,
                            date_debut: filters.date_debut,
                            date_fin: filters.date_fin,
                            pseudo: filters.pseudo
                        }) }}" {% if currentPage >= totalPages %}tabindex="-1" aria-disabled="true"{% endif %}>
                            Suivant
                            <i class="bi bi-chevron-right" aria-hidden="true"></i>
                        </a>
                    </li>
                </ul>
                <p class="text-center text-secondary small mt-2">
                    Page {{ currentPage }} sur {{ totalPages }} — {{ total }} personnage{{ total > 1 ? 's' : '' }} trouvé{{ total > 1 ? 's' : '' }}
                </p>
            </nav>
        {% endif %}
    {% else %}
        <div class="text-center py-5">
            <i class="bi bi-emoji-neutral display-1 text-secondary" aria-hidden="true"></i>
            <h2 class="h5 text-secondary mt-3">Aucun personnage trouvé</h2>
            <p class="text-secondary">Modifiez vos filtres ou revenez plus tard pour découvrir de nouvelles créations.</p>
            <a href="{{ path('app_personnages') }}" class="btn btn-outline-primary">
                <i class="bi bi-arrow-counterclockwise me-1" aria-hidden="true"></i>
                Réinitialiser les filtres
            </a>
        </div>
    {% endif %}
</div>
{% endblock %}

{% block stylesheets %}
<style>
    .card-hover {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .card-hover:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.3);
    }
</style>
{% endblock %}
