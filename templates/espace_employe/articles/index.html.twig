{% extends 'base.html.twig' %}

{% block title %}Gestion des articles - FantasyRealm Online{% endblock %}

{% block body %}
<div class="container py-5">
    {# En-tete #}
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
        <div>
            <h1 class="display-6 fw-bold mb-1">
                <i class="bi bi-bag text-primary" aria-hidden="true"></i>
                Gestion des articles
            </h1>
            <p class="text-secondary mb-0">
                Gerez le catalogue d'articles disponibles pour les personnages.
            </p>
        </div>
        <div class="d-flex gap-2">
            <a href="{{ path('app_employe_article_create') }}" class="btn btn-success d-flex align-items-center gap-2">
                <i class="bi bi-plus-lg" aria-hidden="true"></i>
                Creer un article
            </a>
            <a href="{{ path('app_espace_employe') }}" class="btn btn-outline-light d-flex align-items-center gap-2">
                <i class="bi bi-arrow-left" aria-hidden="true"></i>
                Retour
            </a>
        </div>
    </div>

    {# Tableau des articles #}
    {% if articles is empty %}
        <div class="card bg-dark border-secondary">
            <div class="card-body text-center py-5">
                <i class="bi bi-bag-x display-1 text-secondary" aria-hidden="true"></i>
                <h2 class="h5 text-secondary mt-3">Aucun article</h2>
                <p class="text-secondary">Le catalogue est vide. Commencez par creer un premier article.</p>
                <a href="{{ path('app_employe_article_create') }}" class="btn btn-success">
                    <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>
                    Creer un article
                </a>
            </div>
        </div>
    {% else %}
        <div class="card bg-dark border-secondary">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th style="width: 60px;">Image</th>
                                <th>Nom</th>
                                <th>Type</th>
                                <th>Statut</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for article in articles %}
                                <tr>
                                    <td>
                                        {% if article.imageDataUrl %}
                                            <img src="{{ article.imageDataUrl }}" alt="{{ article.nom }}"
                                                 class="rounded" style="width: 48px; height: 48px; object-fit: cover;">
                                        {% else %}
                                            <div class="bg-secondary rounded d-flex align-items-center justify-content-center"
                                                 style="width: 48px; height: 48px;">
                                                <i class="bi bi-bag" aria-hidden="true"></i>
                                            </div>
                                        {% endif %}
                                    </td>
                                    <td>
                                        <strong>{{ article.nom }}</strong>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary">{{ article.type|capitalize }}</span>
                                    </td>
                                    <td>
                                        {% if article.actif %}
                                            <span class="badge bg-success">
                                                <i class="bi bi-check-circle me-1" aria-hidden="true"></i> Actif
                                            </span>
                                        {% else %}
                                            <span class="badge bg-danger">
                                                <i class="bi bi-x-circle me-1" aria-hidden="true"></i> Inactif
                                            </span>
                                        {% endif %}
                                    </td>
                                    <td class="text-end">
                                        <div class="d-flex gap-1 justify-content-end">
                                            {# Modifier #}
                                            <a href="{{ path('app_employe_article_edit', {id: article.id}) }}"
                                               class="btn btn-outline-primary btn-sm" title="Modifier">
                                                <i class="bi bi-pencil" aria-hidden="true"></i>
                                            </a>

                                            {# Activer / Desactiver #}
                                            <form method="post" action="{{ path('app_employe_article_toggle', {id: article.id}) }}" class="d-inline">
                                                <input type="hidden" name="_token" value="{{ csrf_token('toggle-article-' ~ article.id) }}">
                                                {% if article.actif %}
                                                    <button type="submit" class="btn btn-outline-warning btn-sm" title="Desactiver">
                                                        <i class="bi bi-pause-circle" aria-hidden="true"></i>
                                                    </button>
                                                {% else %}
                                                    <button type="submit" class="btn btn-outline-success btn-sm" title="Activer">
                                                        <i class="bi bi-play-circle" aria-hidden="true"></i>
                                                    </button>
                                                {% endif %}
                                            </form>

                                            {# Supprimer #}
                                            <button type="button" class="btn btn-outline-danger btn-sm"
                                                    data-bs-toggle="modal" data-bs-target="#deleteArticleModal{{ article.id }}"
                                                    title="Supprimer">
                                                <i class="bi bi-trash" aria-hidden="true"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        {# Modals de suppression #}
        {% for article in articles %}
            <div class="modal fade" id="deleteArticleModal{{ article.id }}" tabindex="-1"
                 aria-labelledby="deleteArticleModalLabel{{ article.id }}" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content bg-dark border-danger">
                        <div class="modal-header border-danger">
                            <h5 class="modal-title" id="deleteArticleModalLabel{{ article.id }}">
                                <i class="bi bi-trash text-danger me-2" aria-hidden="true"></i>
                                Supprimer l'article
                            </h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                        </div>
                        <div class="modal-body">
                            <div class="alert alert-danger d-flex align-items-start gap-2" role="alert">
                                <i class="bi bi-exclamation-triangle-fill mt-1" aria-hidden="true"></i>
                                <strong>Action irreversible !</strong>
                            </div>
                            <p>Êtes-vous sûr de vouloir supprimer définitivement l'article <strong class="text-danger">{{ article.nom }}</strong> ?</p>
                        </div>
                        <div class="modal-footer border-secondary">
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annuler</button>
                            <form method="post" action="{{ path('app_employe_article_delete', {id: article.id}) }}" class="d-inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete-article-' ~ article.id) }}">
                                <button type="submit" class="btn btn-danger">
                                    <i class="bi bi-trash me-1" aria-hidden="true"></i> Supprimer definitivement
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
    {% endif %}
</div>
{% endblock %}
