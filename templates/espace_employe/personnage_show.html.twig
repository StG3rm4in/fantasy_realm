{% extends 'base.html.twig' %}

{% block title %}{{ personnage.nom }} - Moderation - FantasyRealm Online{% endblock %}

{% block body %}
<div class="container py-5">
    {# Lien retour #}
    <div class="mb-4">
        <a href="{{ path('app_espace_employe') }}" class="btn btn-outline-light btn-sm d-flex align-items-center gap-2 d-inline-flex">
            <i class="bi bi-arrow-left" aria-hidden="true"></i>
            Retour au tableau de bord
        </a>
    </div>

    <div class="row g-4">
        {# Colonne gauche : Image et informations principales #}
        <div class="col-lg-5">
            <div class="card bg-dark border-secondary sticky-top" style="top: 2rem;">
                <div class="card-body p-4">
                    {# Image du personnage #}
                    <div class="text-center mb-4">
                        {% if personnage.imageDataUrl %}
                            <img src="{{ personnage.imageDataUrl }}"
                                 alt="Portrait de {{ personnage.nom }}"
                                 class="img-fluid rounded"
                                 style="max-width: min(400px, 100%);">
                        {% else %}
                            <div class="bg-secondary rounded d-flex align-items-center justify-content-center" style="height: 400px;">
                                <i class="bi bi-person-bounding-box" style="font-size: 6rem; opacity: 0.3;" aria-hidden="true"></i>
                            </div>
                        {% endif %}
                    </div>

                    {# Nom et genre #}
                    <h2 class="text-center mb-2">{{ personnage.nom }}</h2>
                    <p class="text-center text-secondary mb-3">{{ personnage.genre }}</p>

                    {# Statut #}
                    <div class="text-center mb-4">
                        {% if personnage.autorise is null %}
                            <span class="badge bg-warning text-dark fs-6">
                                <i class="bi bi-hourglass-split me-1" aria-hidden="true"></i>
                                En attente de moderation
                            </span>
                        {% elseif personnage.autorise %}
                            <span class="badge bg-success fs-6">
                                <i class="bi bi-check-circle me-1" aria-hidden="true"></i>
                                Approuve
                            </span>
                        {% else %}
                            <span class="badge bg-danger fs-6">
                                <i class="bi bi-x-circle me-1" aria-hidden="true"></i>
                                Rejete
                            </span>
                        {% endif %}

                        {% if personnage.partage %}
                            <span class="badge bg-info bg-opacity-25 text-info fs-6 ms-1">
                                <i class="bi bi-globe me-1" aria-hidden="true"></i>
                                Partage
                            </span>
                        {% else %}
                            <span class="badge bg-secondary bg-opacity-25 text-secondary fs-6 ms-1">
                                <i class="bi bi-lock me-1" aria-hidden="true"></i>
                                Prive
                            </span>
                        {% endif %}
                    </div>

                    {# Actions de moderation #}
                    <div class="d-grid gap-2 mb-4">
                        {% if personnage.autorise is null %}
                        <form method="post" action="{{ path('app_employe_personnage_approve', {id: personnage.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('approve-personnage-' ~ personnage.id) }}">
                            <button type="submit" class="btn btn-success btn-lg w-100"
                                    onclick="return confirm('Approuver ce personnage ?')">
                                <i class="bi bi-check-circle me-2" aria-hidden="true"></i>
                                Approuver
                            </button>
                        </form>

                        <button type="button" class="btn btn-danger btn-lg w-100"
                                data-bs-toggle="modal" data-bs-target="#rejectModal">
                            <i class="bi bi-x-circle me-2" aria-hidden="true"></i>
                            Rejeter
                        </button>
                        {% endif %}

                        <button type="button" class="btn btn-outline-danger w-100"
                                data-bs-toggle="modal" data-bs-target="#deleteModal">
                            <i class="bi bi-trash me-2" aria-hidden="true"></i>
                            Supprimer
                        </button>
                    </div>

                    {# Informations sur le createur #}
                    <div class="pt-4 border-top border-secondary">
                        <h4 class="h6 mb-3">
                            <i class="bi bi-person-badge text-primary me-2" aria-hidden="true"></i>
                            Informations du createur
                        </h4>
                        <p class="text-secondary small mb-1">Pseudo</p>
                        <p class="fw-semibold mb-2">{{ personnage.utilisateur.pseudo }}</p>
                        <p class="text-secondary small mb-1">Email</p>
                        <p class="fw-semibold mb-0">{{ personnage.utilisateur.email }}</p>
                    </div>
                </div>
            </div>
        </div>

        {# Colonne droite : Caracteristiques detaillees #}
        <div class="col-lg-7">
            {# Apparence physique #}
            <div class="card bg-dark border-secondary mb-4">
                <div class="card-body p-4">
                    <h3 class="mb-4">
                        <i class="bi bi-palette text-primary me-2" aria-hidden="true"></i>
                        Apparence physique
                    </h3>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="p-3 bg-dark bg-opacity-50 rounded border border-secondary">
                                <p class="text-secondary small mb-1">Couleur de peau</p>
                                <p class="fw-semibold mb-0">{{ personnage.couleurPeau|capitalize }}</p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 bg-dark bg-opacity-50 rounded border border-secondary">
                                <p class="text-secondary small mb-1">Couleur des yeux</p>
                                <p class="fw-semibold mb-0">{{ personnage.couleurYeux|capitalize }}</p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 bg-dark bg-opacity-50 rounded border border-secondary">
                                <p class="text-secondary small mb-1">Couleur des cheveux</p>
                                <p class="fw-semibold mb-0">{{ personnage.couleurCheveux|replace({'-': ' '})|capitalize }}</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            {# Traits du visage #}
            <div class="card bg-dark border-secondary mb-4">
                <div class="card-body p-4">
                    <h3 class="mb-4">
                        <i class="bi bi-emoji-smile text-primary me-2" aria-hidden="true"></i>
                        Traits du visage
                    </h3>

                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="p-3 bg-dark bg-opacity-50 rounded border border-secondary">
                                <p class="text-secondary small mb-1">Forme des yeux</p>
                                <p class="fw-semibold mb-0">{{ personnage.formeYeux|replace({'-': ' '})|capitalize }}</p>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-3 bg-dark bg-opacity-50 rounded border border-secondary">
                                <p class="text-secondary small mb-1">Forme du nez</p>
                                <p class="fw-semibold mb-0">{{ personnage.formeNez|capitalize }}</p>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-3 bg-dark bg-opacity-50 rounded border border-secondary">
                                <p class="text-secondary small mb-1">Forme de la bouche</p>
                                <p class="fw-semibold mb-0">{{ personnage.formeBouche|capitalize }}</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            {# Articles equipes #}
            <div class="card bg-dark border-secondary">
                <div class="card-body p-4">
                    <h3 class="mb-4">
                        <i class="bi bi-bag text-primary me-2" aria-hidden="true"></i>
                        Articles equipes
                    </h3>

                    {% if personnage.articles is defined and personnage.articles|length > 0 %}
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Image</th>
                                        <th>Nom</th>
                                        <th>Type</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for article in personnage.articles %}
                                        <tr>
                                            <td>
                                                {% if article.imageDataUrl %}
                                                    <img src="{{ article.imageDataUrl }}" alt="{{ article.nom }}"
                                                         class="rounded" style="width: 40px; height: 40px; object-fit: cover;">
                                                {% else %}
                                                    <div class="bg-secondary rounded d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                                        <i class="bi bi-bag" aria-hidden="true"></i>
                                                    </div>
                                                {% endif %}
                                            </td>
                                            <td><strong>{{ article.nom }}</strong></td>
                                            <td>
                                                <span class="badge bg-secondary">{{ article.type|capitalize }}</span>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% else %}
                        <div class="text-center py-4 text-secondary">
                            <i class="bi bi-bag-x display-4" aria-hidden="true"></i>
                            <p class="mt-3 mb-0">Aucun article equipe</p>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>

{# Modal de rejet #}
<div class="modal fade" id="rejectModal" tabindex="-1" aria-labelledby="rejectModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark border-danger">
            <div class="modal-header border-danger">
                <h5 class="modal-title" id="rejectModalLabel">
                    <i class="bi bi-x-circle text-danger me-2" aria-hidden="true"></i>
                    Rejeter le personnage
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>
            <form method="post" action="{{ path('app_employe_personnage_reject', {id: personnage.id}) }}">
                <div class="modal-body">
                    <input type="hidden" name="_token" value="{{ csrf_token('reject-personnage-' ~ personnage.id) }}">
                    <p>Voulez-vous vraiment rejeter le personnage <strong class="text-danger">{{ personnage.nom }}</strong> ?</p>
                    <p class="text-warning small">
                        <i class="bi bi-exclamation-triangle me-1" aria-hidden="true"></i>
                        Le personnage sera définitivement supprimé. Un email de notification sera envoyé au propriétaire.
                    </p>
                    <div class="mb-3">
                        <label for="reason" class="form-label">Raison du rejet <span class="text-danger">*</span></label>
                        <textarea class="form-control" id="reason" name="reason" rows="4" required
                                  placeholder="Indiquez la raison du rejet..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-x-circle me-1" aria-hidden="true"></i> Confirmer le rejet
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

{# Modal de suppression #}
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark border-danger">
            <div class="modal-header border-danger">
                <h5 class="modal-title" id="deleteModalLabel">
                    <i class="bi bi-trash text-danger me-2" aria-hidden="true"></i>
                    Supprimer le personnage
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>
            <form method="post" action="{{ path('app_employe_personnage_delete', {id: personnage.id}) }}">
                <div class="modal-body">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete-personnage-' ~ personnage.id) }}">
                    <div class="alert alert-danger d-flex align-items-start gap-2" role="alert">
                        <i class="bi bi-exclamation-triangle-fill mt-1" aria-hidden="true"></i>
                        <strong>Action irreversible !</strong>
                    </div>
                    <p>Etes-vous sur de vouloir supprimer definitivement le personnage <strong class="text-danger">{{ personnage.nom }}</strong> ?</p>
                    <p class="text-secondary small mb-0">
                        <i class="bi bi-info-circle me-1" aria-hidden="true"></i>
                        Le personnage et toutes ses donnees associees seront supprimes de maniere permanente.
                    </p>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash me-1" aria-hidden="true"></i> Supprimer definitivement
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}
