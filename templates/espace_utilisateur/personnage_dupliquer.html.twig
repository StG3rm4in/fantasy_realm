{% extends 'base.html.twig' %}

{% block title %}Dupliquer {{ personnage.nom }} - FantasyRealm Online{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            {# Back link #}
            <div class="mb-4">
                <a href="{{ path('app_espace_utilisateur') }}" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>
                    Retour à mon espace
                </a>
            </div>

            <div class="text-center mb-4">
                <h1 class="display-6 fw-bold mb-3">
                    <i class="bi bi-copy text-warning" aria-hidden="true"></i>
                    Dupliquer un personnage
                </h1>
                <p class="text-secondary">
                    Créez une copie de « <strong>{{ personnage.nom }}</strong> » avec un nouveau nom.
                    Toutes les caractéristiques seront dupliquées.
                </p>
            </div>

            {# Character Preview #}
            {% if personnage.imageDataUrl %}
                <div class="text-center mb-4">
                    <img src="{{ personnage.imageDataUrl }}"
                         alt="Portrait de {{ personnage.nom }}"
                         class="rounded border border-secondary"
                         style="width: 150px; height: 150px; object-fit: cover;">
                </div>
            {% endif %}

            <div class="card bg-dark border-secondary">
                <div class="card-body p-4">
                    <form method="post" novalidate>
                        <input type="hidden" name="_token" value="{{ csrf_token('dupliquer_' ~ personnage.id) }}">
                        <div class="mb-4">
                            <label for="nouveau_nom" class="form-label">
                                <i class="bi bi-tag text-primary me-1" aria-hidden="true"></i>
                                Nom du nouveau personnage
                            </label>
                            <input type="text"
                                   class="form-control"
                                   id="nouveau_nom"
                                   name="nouveau_nom"
                                   required
                                   maxlength="50"
                                   placeholder="Ex: {{ personnage.nom }} (copie)"
                                   value="{{ personnage.nom }} (copie)"
                                   autofocus
                                   aria-describedby="nomHelp">
                            <div id="nomHelp" class="form-text">Choisissez un nom unique pour le personnage dupliqué.</div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-warning d-flex align-items-center gap-2">
                                <i class="bi bi-copy" aria-hidden="true"></i>
                                Dupliquer le personnage
                            </button>
                            <a href="{{ path('app_espace_utilisateur') }}" class="btn btn-outline-secondary">
                                Annuler
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
