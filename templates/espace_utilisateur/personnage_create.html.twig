{% extends 'base.html.twig' %}

{% block title %}Creer un personnage - FantasyRealm Online{% endblock %}

{% block body %}
<div class="container py-5">
    {# Back link #}
    <div class="mb-4">
        <a href="{{ path('app_espace_utilisateur') }}" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>
            Retour a mon espace
        </a>
    </div>

    <div class="text-center mb-4">
        <h1 class="display-6 fw-bold mb-3">
            <i class="bi bi-person-plus text-primary" aria-hidden="true"></i>
            Creer un personnage
        </h1>
        <p class="text-secondary">Donnez vie a votre heros de legende en remplissant les champs ci-dessous.</p>
    </div>

    <div class="row g-4">
        {# Preview panel (shown first on mobile) #}
        <div class="col-lg-5 order-1 order-lg-2">
            <div class="sticky-lg-top" style="top: 90px;">
                {% include 'espace_utilisateur/_character_renderer.html.twig' %}
            </div>
        </div>

        {# Form #}
        <div class="col-lg-7 order-2 order-lg-1">
            <div class="card bg-dark border-secondary">
                <div class="card-body p-4">
                    {{ form_start(form, { 'attr': { 'novalidate': 'novalidate' } }) }}
                        <input type="hidden" id="character_image_data" name="character_image_data" value="">
                        {{ form_errors(form) }}

                        <div class="row g-3">
                            {% if form.nom is defined %}
                                <div class="col-12">
                                    <div class="mb-0">
                                        {{ form_label(form.nom, 'Nom du personnage', { 'label_attr': { 'class': 'form-label' } }) }}
                                        {{ form_widget(form.nom, { 'attr': { 'class': 'form-control', 'placeholder': 'Ex: Arthemon le Brave' } }) }}
                                        {{ form_errors(form.nom) }}
                                    </div>
                                </div>
                            {% endif %}

                            {% if form.genre is defined %}
                                <div class="col-sm-6">
                                    <div class="mb-0">
                                        {{ form_label(form.genre, 'Genre', { 'label_attr': { 'class': 'form-label' } }) }}
                                        {{ form_widget(form.genre, { 'attr': { 'class': 'form-select' } }) }}
                                        {{ form_errors(form.genre) }}
                                    </div>
                                </div>
                            {% endif %}

                            {% if form.couleurPeau is defined %}
                                <div class="col-sm-6">
                                    <div class="mb-0">
                                        {{ form_label(form.couleurPeau, 'Couleur de peau', { 'label_attr': { 'class': 'form-label' } }) }}
                                        {{ form_widget(form.couleurPeau, { 'attr': { 'class': 'form-select' } }) }}
                                        {{ form_errors(form.couleurPeau) }}
                                    </div>
                                </div>
                            {% endif %}

                            {% if form.couleurYeux is defined %}
                                <div class="col-sm-6">
                                    <div class="mb-0">
                                        {{ form_label(form.couleurYeux, 'Couleur des yeux', { 'label_attr': { 'class': 'form-label' } }) }}
                                        {{ form_widget(form.couleurYeux, { 'attr': { 'class': 'form-select' } }) }}
                                        {{ form_errors(form.couleurYeux) }}
                                    </div>
                                </div>
                            {% endif %}

                            {% if form.couleurCheveux is defined %}
                                <div class="col-sm-6">
                                    <div class="mb-0">
                                        {{ form_label(form.couleurCheveux, 'Couleur des cheveux', { 'label_attr': { 'class': 'form-label' } }) }}
                                        {{ form_widget(form.couleurCheveux, { 'attr': { 'class': 'form-select' } }) }}
                                        {{ form_errors(form.couleurCheveux) }}
                                    </div>
                                </div>
                            {% endif %}

                            {% if form.formeYeux is defined %}
                                <div class="col-sm-6">
                                    <div class="mb-0">
                                        {{ form_label(form.formeYeux, 'Forme des yeux', { 'label_attr': { 'class': 'form-label' } }) }}
                                        {{ form_widget(form.formeYeux, { 'attr': { 'class': 'form-select' } }) }}
                                        {{ form_errors(form.formeYeux) }}
                                    </div>
                                </div>
                            {% endif %}

                            {% if form.formeNez is defined %}
                                <div class="col-sm-6">
                                    <div class="mb-0">
                                        {{ form_label(form.formeNez, 'Forme du nez', { 'label_attr': { 'class': 'form-label' } }) }}
                                        {{ form_widget(form.formeNez, { 'attr': { 'class': 'form-select' } }) }}
                                        {{ form_errors(form.formeNez) }}
                                    </div>
                                </div>
                            {% endif %}

                            {% if form.formeBouche is defined %}
                                <div class="col-sm-6">
                                    <div class="mb-0">
                                        {{ form_label(form.formeBouche, 'Forme de la bouche', { 'label_attr': { 'class': 'form-label' } }) }}
                                        {{ form_widget(form.formeBouche, { 'attr': { 'class': 'form-select' } }) }}
                                        {{ form_errors(form.formeBouche) }}
                                    </div>
                                </div>
                            {% endif %}
                        </div>

                        {# Render remaining fields (partage radio) #}
                        {{ form_rest(form) }}

                        <div class="mt-4">
                            <button type="submit" class="btn btn-primary d-flex align-items-center gap-2">
                                <i class="bi bi-check-lg" aria-hidden="true"></i>
                                Creer le personnage
                            </button>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
