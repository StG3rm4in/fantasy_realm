{% extends 'base.html.twig' %}

{% block title %}Erreur serveur - FantasyRealm Online{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center min-vh-75 align-items-center">
        <div class="col-md-8 col-lg-6 text-center animate-fade-in">
            <div class="mb-4">
                <i class="bi bi-exclamation-triangle display-1 text-danger"></i>
            </div>
            <h1 class="display-1 fw-bold text-gradient">500</h1>
            <h2 class="h3 fw-bold mb-3">Erreur serveur</h2>
            <p class="text-secondary mb-4">
                Une erreur inattendue s'est produite sur les serveurs de FantasyRealm.
                Nos équipes ont été notifiées. Veuillez réessayer dans quelques instants.
            </p>
            <div class="d-flex flex-column flex-sm-row justify-content-center gap-3">
                <a href="{{ path('app_home') }}" class="btn btn-hero d-inline-flex align-items-center gap-2">
                    <i class="bi bi-house"></i>
                    Retour à l'accueil
                </a>
                <a href="{{ path('app_contact') }}" class="btn btn-hero-outline">
                    Contacter le support
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
