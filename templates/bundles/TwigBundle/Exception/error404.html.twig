{% extends 'base.html.twig' %}

{% block title %}Page non trouvée - FantasyRealm Online{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center min-vh-75 align-items-center">
        <div class="col-md-8 col-lg-6 text-center animate-fade-in">
            <div class="mb-4">
                <i class="bi bi-compass display-1 text-primary"></i>
            </div>
            <h1 class="display-1 fw-bold text-gradient">404</h1>
            <h2 class="h3 fw-bold mb-3">Page non trouvée</h2>
            <p class="text-secondary mb-4">
                Oups ! Il semble que vous vous soyez égaré dans les terres inexplorées de FantasyRealm.
                Cette page n'existe pas ou a été déplacée.
            </p>
            <div class="d-flex flex-column flex-sm-row justify-content-center gap-3">
                <a href="{{ path('app_home') }}" class="btn btn-hero d-inline-flex align-items-center gap-2">
                    <i class="bi bi-house"></i>
                    Retour à l'accueil
                </a>
                <a href="{{ path('app_personnages') }}" class="btn btn-hero-outline">
                    Voir les personnages
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
