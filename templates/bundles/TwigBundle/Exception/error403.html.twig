{% extends 'base.html.twig' %}

{% block title %}Accès refusé - FantasyRealm Online{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center min-vh-75 align-items-center">
        <div class="col-md-8 col-lg-6 text-center animate-fade-in">
            <div class="mb-4">
                <i class="bi bi-shield-lock display-1 text-warning"></i>
            </div>
            <h1 class="display-1 fw-bold text-gradient">403</h1>
            <h2 class="h3 fw-bold mb-3">Accès refusé</h2>
            <p class="text-secondary mb-4">
                Vous n'avez pas les permissions nécessaires pour accéder à cette zone de FantasyRealm.
                Connectez-vous avec un compte autorisé ou retournez à l'accueil.
            </p>
            <div class="d-flex flex-column flex-sm-row justify-content-center gap-3">
                <a href="{{ path('app_home') }}" class="btn btn-hero d-inline-flex align-items-center gap-2">
                    <i class="bi bi-house"></i>
                    Retour à l'accueil
                </a>
                <a href="{{ path('app_login') }}" class="btn btn-hero-outline">
                    Se connecter
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
