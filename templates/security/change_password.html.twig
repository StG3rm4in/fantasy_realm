{% extends 'base.html.twig' %}

{% block title %}Changer le mot de passe - FantasyRealm Online{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="text-center mb-4">
                <h1 class="display-6 fw-bold mb-3">
                    <i class="bi bi-shield-exclamation text-warning" aria-hidden="true"></i>
                    Changement de mot de passe requis
                </h1>
                <p class="text-secondary">
                    Pour des raisons de sécurité, vous devez définir un nouveau mot de passe avant de continuer.
                </p>
            </div>

            <div class="alert alert-warning d-flex align-items-start gap-2" role="alert">
                <i class="bi bi-exclamation-triangle-fill mt-1" aria-hidden="true"></i>
                <div>
                    Vous vous êtes connecté avec le mot de passe temporaire reçu par email.
                    Veuillez en choisir un nouveau conforme aux exigences de sécurité.
                </div>
            </div>

            <div class="card bg-dark border-secondary">
                <div class="card-body p-4">
                    <form method="post" novalidate>
                        <input type="hidden" name="_token" value="{{ csrf_token('changement-mot-de-passe') }}">
                        <div class="mb-3">
                            <label for="new_password" class="form-label">
                                <i class="bi bi-key text-primary me-1" aria-hidden="true"></i>
                                Nouveau mot de passe
                            </label>
                            <div class="input-group">
                                <input type="password"
                                       class="form-control"
                                       id="new_password"
                                       name="new_password"
                                       required
                                       minlength="12"
                                       placeholder="Minimum 12 caractères"
                                       autocomplete="new-password"
                                       autofocus
                                       aria-describedby="passwordStrengthHelp">
                                <button class="btn btn-outline-secondary" type="button" id="togglePassword" aria-label="Afficher ou masquer le mot de passe">
                                    <i class="bi bi-eye" aria-hidden="true"></i>
                                </button>
                            </div>
                            <div id="passwordStrengthHelp" class="form-text">
                                Minimum 12 caractères avec majuscules, minuscules, chiffres et caractères spéciaux.
                            </div>

                            {# Password strength indicator #}
                            <div class="mt-2">
                                <div class="progress" role="progressbar" aria-label="Force du mot de passe" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100" style="height: 8px;">
                                    <div class="progress-bar" id="passwordStrengthBar" style="width: 0%;"></div>
                                </div>
                                <small id="passwordStrengthText" class="text-secondary mt-1 d-block"></small>
                            </div>

                            <ul class="list-unstyled small mt-2 mb-0" id="passwordCriteria">
                                <li id="criteria-length" class="text-secondary">
                                    <i class="bi bi-x-circle" aria-hidden="true"></i> Minimum 12 caractères
                                </li>
                                <li id="criteria-uppercase" class="text-secondary">
                                    <i class="bi bi-x-circle" aria-hidden="true"></i> Au moins une majuscule
                                </li>
                                <li id="criteria-lowercase" class="text-secondary">
                                    <i class="bi bi-x-circle" aria-hidden="true"></i> Au moins une minuscule
                                </li>
                                <li id="criteria-digit" class="text-secondary">
                                    <i class="bi bi-x-circle" aria-hidden="true"></i> Au moins un chiffre
                                </li>
                                <li id="criteria-special" class="text-secondary">
                                    <i class="bi bi-x-circle" aria-hidden="true"></i> Au moins un caractère spécial
                                </li>
                            </ul>
                        </div>

                        <div class="mb-4">
                            <label for="confirm_password" class="form-label">
                                <i class="bi bi-key-fill text-primary me-1" aria-hidden="true"></i>
                                Confirmer le mot de passe
                            </label>
                            <input type="password"
                                   class="form-control"
                                   id="confirm_password"
                                   name="confirm_password"
                                   required
                                   minlength="12"
                                   placeholder="Retapez votre mot de passe"
                                   autocomplete="new-password">
                            <div id="confirmPasswordFeedback" class="form-text"></div>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-2 d-flex align-items-center justify-content-center gap-2">
                            <i class="bi bi-check-lg" aria-hidden="true"></i>
                            Changer le mot de passe
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
