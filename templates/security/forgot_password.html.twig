{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié - FantasyRealm Online{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="text-center mb-4">
                <h1 class="display-6 fw-bold mb-3">
                    <i class="bi bi-envelope-paper text-primary" aria-hidden="true"></i>
                    Mot de passe oublié
                </h1>
                <p class="text-secondary">
                    Saisissez votre adresse email et votre pseudo pour recevoir un lien de réinitialisation.
                </p>
            </div>

            <div class="card bg-dark border-secondary">
                <div class="card-body p-4">
                    <form method="post" novalidate>
                        <input type="hidden" name="_token" value="{{ csrf_token('mot-de-passe-oublie') }}">
                        <div class="mb-3">
                            <label for="email" class="form-label">
                                <i class="bi bi-envelope text-primary me-1" aria-hidden="true"></i>
                                Adresse email
                            </label>
                            <input type="email"
                                   class="form-control"
                                   id="email"
                                   name="email"
                                   required
                                   maxlength="255"
                                   placeholder="votre@email.com"
                                   autocomplete="email"
                                   autofocus
                                   aria-describedby="emailHelp">
                            <div id="emailHelp" class="form-text">L'adresse email associée à votre compte.</div>
                        </div>

                        <div class="mb-4">
                            <label for="pseudo" class="form-label">
                                <i class="bi bi-person text-primary me-1" aria-hidden="true"></i>
                                Pseudo
                            </label>
                            <input type="text"
                                   class="form-control"
                                   id="pseudo"
                                   name="pseudo"
                                   required
                                   maxlength="50"
                                   placeholder="VotrePseudo"
                                   autocomplete="username"
                                   aria-describedby="pseudoHelp">
                            <div id="pseudoHelp" class="form-text">Le pseudo utilisé lors de votre inscription.</div>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-2 d-flex align-items-center justify-content-center gap-2">
                            <i class="bi bi-send" aria-hidden="true"></i>
                            Envoyer le lien de réinitialisation
                        </button>
                    </form>
                </div>
            </div>

            <div class="text-center mt-4">
                <a href="{{ path('app_login') }}" class="text-secondary text-decoration-none">
                    <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>
                    Retour à la connexion
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
